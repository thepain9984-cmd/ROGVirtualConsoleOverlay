<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/trigger_pressed" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/rog_red_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/trigger_bg" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/rog_light_gray" />
        </shape>
    </item>
</selector>
